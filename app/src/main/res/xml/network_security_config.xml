<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Disabling cleartext traffic by default for security.
         CardDAV servers typically use HTTPS. -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
