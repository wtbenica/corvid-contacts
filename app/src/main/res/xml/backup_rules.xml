<?xml version="1.0" encoding="utf-8"?>
<!-- Android 11 and older: nothing goes to the user's Google backup (see data_extraction_rules.xml). -->
<full-backup-content>
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
</full-backup-content>
