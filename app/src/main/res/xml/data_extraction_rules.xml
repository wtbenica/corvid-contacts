<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <!-- Nothing goes to the user's Google backup: a contacts app's data is theirs and their server's.
         Contacts are not recoverable from it, so the app tells local-only users to export. -->
    <cloud-backup>
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <!-- Direct phone-to-phone transfer keeps the data, but not the login, so a transferred app never
         silently re-authenticates with credentials that may be stale or revoked. -->
    <device-transfer>
        <exclude domain="file" path="datastore/auth_prefs.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
